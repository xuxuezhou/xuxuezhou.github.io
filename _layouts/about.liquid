---
layout: default
---
<div class="post home">
  <div class="home-grid">
    <!-- Profile sidebar -->
    <aside class="home-sidebar">
      <div class="profile-card">
        {% if page.profile and page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid profile-photo rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid profile-photo' %}
          {% endif %}
          {% capture sizes %}(min-width: 992px) 280px, (min-width: 576px) 240px, 60vw{% endcapture %}
          <div class="profile-photo-wrap">
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          </div>
        {% endif %}

        <header class="post-header profile-header">
          <h1 class="post-title profile-name">
            {% if site.title == 'blank' %}
              <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
              {{ site.last_name }}
            {% else %}
              {{ site.title }}
            {% endif %}
          </h1>
          <p class="desc">{{ page.subtitle }}</p>
        </header>

        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}

        {% if page.social %}
          <div class="social">
            <div class="contact-icons">{% include social.liquid %}</div>
            <div class="contact-note">{{ site.contact_note }}</div>
          </div>
        {% endif %}
      </div>
    </aside>

    <!-- Main column -->
    <article class="home-main">
      <section class="home-section about-content">
        <h2 class="section-title">about</h2>
        {{ content }}
      </section>

      <!-- News -->
      {% if page.announcements and page.announcements.enabled %}
        <section class="home-section">
          <h2 class="section-title">
            <a href="{{ '/news/' | relative_url }}">news</a>
          </h2>
          {% include news.liquid limit=true %}
        </section>
      {% endif %}

      <!-- Latest posts -->
      {% if page.latest_posts and page.latest_posts.enabled %}
        <section class="home-section">
          <h2 class="section-title">
            <a href="{{ '/blog/' | relative_url }}">latest posts</a>
          </h2>
          {% include latest_posts.liquid %}
        </section>
      {% endif %}

      <!-- Selected papers -->
      {% if page.selected_papers %}
        <section class="home-section">
          <h2 class="section-title">
            <a href="{{ '/publications/' | relative_url }}">selected publications</a>
          </h2>
          {% include selected_papers.liquid %}
        </section>
      {% endif %}

      {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    </article>
  </div>
</div>
