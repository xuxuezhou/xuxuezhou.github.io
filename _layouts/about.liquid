---
layout: default
---
{% assign cv_url = '/assets/pdf/Xuezhou_Xu_CV.pdf' | relative_url %}
<!-- Section navigation: each link scrolls to its block below -->
<nav class="home-nav" aria-label="Sections">
  <div class="home-nav-inner">
    <a class="home-nav-brand" href="#about">
      {%- if site.title == 'blank' -%}
        {{ site.first_name }}
        {{ site.last_name }}
      {%- else -%}
        {{ site.title }}
      {%- endif -%}
    </a>
    <div class="home-nav-links">
      <a href="#about" data-section="about" class="active">Bio</a>
      {% if page.announcements and page.announcements.enabled %}
        <a href="#news" data-section="news">News</a>
      {% endif %}
      {% if page.selected_papers %}
        <a href="#publications" data-section="publications">Publication</a>
      {% endif %}
      <a href="#blogs" data-section="blogs">Blogs</a>
    </div>
  </div>
</nav>

<div class="post home">
  <section id="about">
    <!-- Name -->
    <header class="home-header">
      <h1 class="page-heading">
        {% if site.title == 'blank' %}
          {{ site.first_name }}
          {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
    </header>

    <!-- Photo + links | Bio -->
    <div class="home-intro">
      <div class="home-intro-photo">
        {% if page.profile and page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid profile-photo rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid profile-photo' %}
          {% endif %}
          {% capture sizes %}(min-width: 900px) 260px, (min-width: 576px) 30vw, 70vw{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}

        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}

        <!-- Link row: CV and contact links -->
        <div class="link-row">
          <span class="link-item"><a href="{{ cv_url }}" target="_blank" rel="noopener">CV</a></span>
          {%- if page.social %}
            {% include social_text.liquid %}
          {%- endif -%}
        </div>
      </div>

      <div class="home-intro-bio">
        {% if page.subtitle %}
          <p class="desc">{{ page.subtitle }}</p>
        {% endif %}
        {{ content }}
      </div>
    </div>
  </section>

  <!-- News -->
  {% if page.announcements and page.announcements.enabled %}
    <hr>
    <section class="home-section" id="news">
      <h2 class="section-heading">
        <a href="{{ '/news/' | relative_url }}">News</a>
      </h2>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  <!-- Latest posts -->
  {% if page.latest_posts and page.latest_posts.enabled %}
    <hr>
    <section class="home-section">
      <h2 class="section-heading">
        <a href="{{ '/blog/' | relative_url }}">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    </section>
  {% endif %}

  <!-- Selected papers -->
  {% if page.selected_papers %}
    <hr>
    <section class="home-section" id="publications">
      <h2 class="section-heading">
        <a href="{{ '/publications/' | relative_url }}">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <!-- Blogs -->
  <hr>
  <section class="home-section" id="blogs">
    <h2 class="section-heading">Blogs</h2>
    {% assign home_posts = site.posts | where_exp: 'post', 'post.hidden != true' %}
    {% if home_posts.size > 0 %}
      <ul class="news-list">
        {% for post in home_posts limit: 5 %}
          <li>
            <span class="news-date">[{{ post.date | date: '%m/%Y' }}]</span>
            <a href="{% if post.redirect %}{{ post.redirect }}{% else %}{{ post.url | relative_url }}{% endif %}">{{ post.title }}</a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="blogs-empty">Coming soon.</p>
    {% endif %}
  </section>

  {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
    {% include newsletter.liquid center=true %}
  {% endif %}
</div>

<script>
  // Highlight the nav link of the section currently in view.
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll('.home-nav-links a[data-section]'));
    if (!links.length) return;
    function activate(link) {
      links.forEach(function (a) {
        a.classList.toggle('active', a === link);
      });
    }
    function update() {
      var current = links[0];
      // At the very bottom the last block can't reach the top, so pick it.
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        current = links[links.length - 1];
      } else {
        var mark = window.innerHeight * 0.35;
        links.forEach(function (a) {
          var el = document.getElementById(a.getAttribute('data-section'));
          if (el && el.getBoundingClientRect().top <= mark) current = a;
        });
      }
      activate(current);
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
